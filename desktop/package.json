{
  "name": "precrime-desktop",
  "productName": "Pre-Crime Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-Crime Studio — operar o pipeline de previsão de hotspots (importar SSP, limpar, treinar, validar, publicar) sem terminal.",
  "author": "Rodrigo dos Santos Faustino",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node tools/dev-icon.cjs",
    "start": "electron .",
    "predev": "node tools/dev-icon.cjs",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis --x64",
    "postdist": "node tools/check_package.js",
    "check:pkg": "node tools/check_package.js",
    "dist:dir": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.12.0",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "br.com.faustinopsy.precrime-studio",
    "productName": "Pre-Crime Studio",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pre-Crime-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Pre-Crime Studio",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "1046"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Science",
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "src/main/workers/**"
    ],
    "extraResources": [
      {
        "from": "../pipeline",
        "to": "pipeline",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "../base",
        "to": "base",
        "filter": [
          "**/*",
          "!README.md"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../requirements.lock",
        "to": "requirements.lock"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "src/renderer/assets/icon-256.png",
        "to": "icon-256.png"
      }
    ],
    "publish": null
  }
}
